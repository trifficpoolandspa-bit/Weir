// quote-response: the Approve / Deny buttons in a quote email.
//
// Opening a button's link (GET) only shows a page asking the customer to
// confirm; the answer is recorded when they press that page's button (POST).
// Email safety scanners open links but never press buttons, so they can't
// approve or deny a quote by accident. The first answer counts.
//
// Deploy in Supabase (Edge Functions) as "quote-response" with
// "Verify JWT" OFF: the customer isn't signed in.

import { createClient } from "npm:@supabase/supabase-js@2";

const esc = (s: string) => String(s || "").replace(/[&<>"']/g, c =>
  ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c] as string));

function page(title: string, body: string): Response {
  const html = `<!doctype html><html><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>${esc(title)}</title></head>
<body style="margin:0;background:#F4F6F5;font-family:-apple-system,Segoe UI,Roboto,Arial,sans-serif;color:#1F2D2B;">
<div style="max-width:480px;margin:48px auto;background:#fff;border-radius:14px;padding:28px 26px;border:1px solid #E6E9E8;">
<h1 style="font-size:20px;margin:0 0 12px;">${esc(title)}</h1>${body}</div></body></html>`;
  return new Response(html, { headers: { "content-type": "text/html; charset=utf-8" } });
}

Deno.serve(async (req) => {
  const url = new URL(req.url);
  let token = url.searchParams.get("t") || "";
  let action = url.searchParams.get("a") || "";
  if (req.method === "POST") {
    const form = await req.formData();
    token = String(form.get("t") || "");
    action = String(form.get("a") || "");
  }
  const outcome = action === "approve" ? "approved" : action === "deny" ? "denied" : null;
  if (!token || !outcome) {
    return page("This link isn't complete", `<p style="font-size:15px;">Please use the button in your email, or contact us directly.</p>`);
  }

  const sb = createClient(Deno.env.get("SUPABASE_URL")!, Deno.env.get("SUPABASE_SERVICE_ROLE_KEY")!);
  const { data: row } = await sb.from("quote_responses")
    .select("company_id, outcome").eq("token", token).maybeSingle();
  if (!row) {
    return page("This quote can't be found", `<p style="font-size:15px;">It may have been replaced by a newer one. Please use the latest email, or contact us directly.</p>`);
  }
  const { data: co } = await sb.from("companies").select("name").eq("id", row.company_id).maybeSingle();
  const company = esc(co?.name || "us");

  if (row.outcome) {
    return page("Your answer is already in",
      `<p style="font-size:15px;">This quote was already <strong>${row.outcome === "approved" ? "approved" : "denied"}</strong>. If that's not right, please contact ${company}.</p>`);
  }

  // Opening the link: confirm first
  if (req.method !== "POST") {
    const approve = outcome === "approved";
    return page(approve ? "Approve this quote?" : "Deny this quote?",
      `<p style="font-size:15px;margin:0 0 20px;">Press the button to let ${company} know.</p>
<form method="POST"><input type="hidden" name="t" value="${esc(token)}"><input type="hidden" name="a" value="${esc(action)}">
<button type="submit" style="width:100%;padding:14px;border:0;border-radius:10px;font-size:16px;font-weight:700;cursor:pointer;color:#fff;background:${approve ? "#134E4A" : "#B8492E"};">${approve ? "Approve this quote" : "Deny this quote"}</button></form>`);
  }

  // Pressed: the first answer counts
  const { data: saved } = await sb.from("quote_responses")
    .update({ outcome, responded_at: new Date().toISOString() })
    .eq("token", token).is("outcome", null).select("outcome");
  if (!saved || !saved.length) {
    return page("Your answer is already in", `<p style="font-size:15px;">Thank you — ${company} already has your answer.</p>`);
  }
  return page(outcome === "approved" ? "Thank you — quote approved" : "Thank you — quote denied",
    `<p style="font-size:15px;">${company} has your answer. You can close this page.</p>`);
});
